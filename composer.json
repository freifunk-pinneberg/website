{
  "name": "freifunk-pinneberg/website",
  "description": "Freifunk Pinneberg Website",
  "license": "CC-BY-NC-4.0",
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.typo3.org/"
    },
    {
      "type": "git",
      "url": "git@github.com:freifunk-pinneberg/typo3-tx_ffpi_nodecounter.git"
    },
    {
      "type": "git",
      "url": "git@github.com:freifunk-pinneberg/typo3-tx_ffpi_theme.git"
    },
    {
      "type": "git",
      "url": "git@github.com:freifunk-pinneberg/typo3-tx_ffpi_helgo_theme.git"
    },
    {
      "type": "git",
      "url": "git@github.com:freifunk-pinneberg/typo3-tx_ffpi_node_updates.git"
    },
    {
      "type": "git",
      "url": "git@github.com:freifunk-pinneberg/typo3-tx_ffpi_firmware_list.git"
    }
  ],
  "config": {
    "vendor-dir": "vendor",
    "bin-dir": "bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "minimum-stability": "beta",
  "require": {
    "typo3/cms-composer-installers": "*",
    "typo3/cms-core": "13.4.*",
    "typo3/cms-base-distribution": "13.4.*",
    "typo3/cms-recycler": "13.4.*",
    "typo3/cms-filemetadata": "13.4.*",
    "typo3/cms-workspaces": "13.4.*",
    "typo3/cms-backend": "13.4.*",
    "typo3/cms-beuser": "13.4.*",
    "typo3/cms-redirects": "13.4.*",
    "typo3/cms-linkvalidator": "13.4.*",
    "typo3/cms-lowlevel": "13.4.*",
    "typo3/cms-lang": "13.4.*",
    "typo3/cms-seo": "13.4.*",
    "typo3/cms-scheduler": "13.4.*",
    "ffpi/ffpi-theme": "dev-feature/typo3v13",
    "ffpi/ffpi-helgo-theme": "dev-feature/typo3-13",
    "ffpi/firmware-list": "dev-feature/typo3-13",
    "ffpi/node-updates": "dev-feature/typo3-13",
    "ffpi/nodecounter": "dev-feature/typo3-13",
    "helhum/typo3-console": "*",
    "netresearch/rte-ckeditor-image": "*",
    "lochmueller/staticfilecache": "*"
  },
  "require-dev": {
    "deployer/deployer": "^8.0",
    "ssch/typo3-rector": "^3.0",
    "michielroos/typo3scan": "^1.7",
    "saschaegerer/phpstan-typo3": "^3.0",
    "phpstan/phpstan": "^2.2",
    "helmich/typo3-typoscript-lint": "^3.3"
  },
  "extra": {
    "typo3/cms": {
      "web-dir": "web"
    }
  },
  "scripts": {
    "post-update-cmd": [
    ],
    "post-install-cmd": [
    ]
  },
  "autoload": {
    "psr-4": {
    }
  }
}
